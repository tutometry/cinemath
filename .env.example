# Required: Anthropic API key (teaching / OCR only — not animation).
ANTHROPIC_API_KEY=

# Optional: org keys that are not workspace-scoped must send this header on every request.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional model overrides (classify/extract vs freeform teach)
# ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5
# ANTHROPIC_TEACH_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5   # fallback when the above are unset
# CINEMATH_LOG_LEVEL=INFO           # DEBUG|INFO|WARNING|ERROR
# CINEMATH_LOG_COLOR=1              # 0 to disable ANSI colors
# CINEMATH_LOG_LINKS=1              # OSC-8 clickable paths (TTY default)
# CINEMATH_OUTPUT_DIR=outputs
# CINEMATH_LAYOUT_DEBUG=1           # colored hitboxes + region bands in MP4s
# CINEMATH_LAYOUT_DEBUG_LABELS=1    # show object ids on hitboxes (verbose)
# CINEMATH_WATERMARK=0              # 0 to hide bottom-right “© 2026 Tutometry” mark

# --- Optional lesson narration (default off; no always-on TTS) ---
# CINEMATH_ENABLE_NARRATION=0
# CINEMATH_TTS_ENGINE=auto          # auto | kokoro | piper | mock
# CINEMATH_TTS_MOCK=0               # 1 = placeholder tone WAVs (no model download)
# CINEMATH_TTS_MODEL_DIR=/var/lib/cinemath/tts   # mount volume — not baked in image
# CINEMATH_KOKORO_ONNX=/var/lib/cinemath/tts/kokoro-v1.0.int8.onnx
# CINEMATH_KOKORO_VOICES=/var/lib/cinemath/tts/voices-v1.0.bin
# CINEMATH_KOKORO_VOICE=af_heart
# CINEMATH_PIPER_MODEL=/var/lib/cinemath/tts/en_US-lessac-medium.onnx

# --- HTTP worker (production container on mautedpc) ---
# WORKER_SHARED_SECRET=   # same value as CINEMATH_WORKER_SECRET on the Tutometry app
# PORT=8080
# CINEMATH_WORKER_ARTIFACT_DIR=/artifacts
