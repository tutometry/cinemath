# Canonical production configuration keys.
# Store values in GitHub → Settings → Secrets and variables → Actions (same names).
# deploy-lib.sh writes ~/homelab/stacks/tutometry/.env from this list on every deploy.
# Local dev: copy names into .env.local (see .env.example).

GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
SESSION_SECRET
POSTGRES_PASSWORD
PUBLIC_URL
ADMIN_EMAILS
SAAS_OWNER_ALLOWLIST
SAAS_OPEN_SIGNUP
SAAS_SIGNUP_CREDITS
STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_PRICE_CREDIT_PACK_ID
STRIPE_CREDIT_PACK_AMOUNT
CINEMATH_WORKER_URL
CINEMATH_WORKER_SECRET
GENERATION_WORKER_SECRET
ANTHROPIC_API_KEY
ANTHROPIC_WORKSPACE_ID
RESEND_API_KEY
EMAIL_FROM
REVALIDATE_SECRET
